#include <cs50.h>
#include <stdio.h>
#include <math.h>      //mathematical function (pow)
#include <string.h>

int main(void)
{


    //Displaying program title
    printf("Simple Calculator\n");

char operator = get_char("Enter an operator (+, -, *, /,^,%%): ");//asking for valid operator, also always make sure to use %% where escape is required(% only works if get char or directly modulo operation in code), but requires use of %% in case of printf etc
 do
    {
        operator = get_char("Enter an operator (+, -, *, /,^, %%): ");
        if (operator != '+' && operator != '-' && operator != '*' && operator != '/' && operator != '^' && operator != '%')
        {
            printf("Error! Invalid operator '%c'. Please enter one of +, -, *, /,^, %%\n", operator);
        }
    } while (operator != '+' && operator != '-' && operator != '*' && operator != '/' && operator != '^' && operator != '%');

    float num1 = get_float("Enter first number: ");
   float num2 = get_float("Enter second number: ");

    //calculation based on the operator using switch statement
    switch(operator)
    {
        case '+':
            //Addition
            printf("%.2f + %.2f = %.2f\n", num1, num2, num1 + num2);
            break;

        case '-':
            //Subtraction
            printf("%.2f - %.2f = %.2f\n", num1, num2, num1 - num2);
            break;

        case '*':
            //multiplication
            printf("%.2f * %.2f = %.2f\n", num1, num2, num1 * num2);
            break;

        case '/':
            //division and zero-division check
            if (num2 != 0)
            {
                printf("%.2f / %.2f = %.2f\n", num1, num2, num1 / num2);
            }
            else
            {
                printf("Error! Division by zero is undefined.\n");
            }
            break;

        case '^':
            //(Power) math.h pow function
            printf("%.2f ^ %.2f = %.2f\n", num1, num2, pow(num1, num2));
            break;

        case '%':
            //Modulo operation
            if ((int)num2 != 0)
            {
                printf("%.0f %% %.0f = %.0f\n", num1, num2, fmod(num1, num2));
            }
            else
            {
                printf("Error! Modulo by zero is undefined.\n");
            }
            break;

      
    }

    return 0;
}
