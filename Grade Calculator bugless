#include <stdio.h>
#include <stdlib.h>//one of the best libraries to fix error and invalid input problems  (whitespace problem in this program)
#include <string.h>//very useful for string manipulation
#include <ctype.h>//overall fun functions

int is_positive_integer(const char *s)
{
                                        //empty string not valid
    if (*s == '\0') return 0;
    while (isspace((unsigned char)*s)) s++;


    const char *p = s;//characters must be digits
    while (*p != '\0' && *p != '\n')
     {
        if (!isdigit((unsigned char)*p)) return 0;
        p++;
    }

    //check positive
    long val = strtol(s, NULL, 10); //remember stdlib manual
    return val > 0;
}

int main(void)
{
    char buf[64];
    int num_subjects;
    float total = 0.0f, average;
    float grade;

    printf("Grade Calculator\n");

    //while looping until a valid positive integer is entered
    while (1)
    {
        printf("Enter number of subjects: ");
        if (!fgets(buf, sizeof buf, stdin)) {
            // Input error
            continue;
        }
        if (!is_positive_integer(buf)) {
            printf("Invalid input! Please enter a positive integer.\n");
            continue;
        }
        num_subjects = (int)strtol(buf, NULL, 10);
        break;
    }

    //read grades only with 0–100 validation
    for (int i = 1; i <= num_subjects; i++)
     {
        while (1)
        {
            printf("Enter grade for subject %d (0–100): ", i);
            if (!fgets(buf, sizeof buf, stdin)) {
                continue;
            }

            char *endptr;                         //must not whitespaceeeeeee, endptr is very useful
            grade = strtof(buf, &endptr);
            while (isspace((unsigned char)*endptr)) endptr++;
            if (*endptr != '\0' && *endptr != '\n')
             {
                printf("Invalid grade! Please enter a number between 0 and 100.\n");
                continue;
            }
            if (grade < 0.0f || grade > 100.0f) {
                printf("Invalid grade! Please enter a number between 0 and 100.\n");
                continue;
            }
            break;
        }
        total += grade;
    }

    average = total / num_subjects;
    printf("\nYour average score is: %.2f\n", average);

    if (average >= 95.0f)
        printf("Grade: A+\n");
    else if (average >= 90.0f)
        printf("Grade: A\n");
    else if (average >= 85.0f)
        printf("Grade: A-\n");
    else if (average >= 80.0f)
        printf("Grade:B+ \n");
    else if (average >= 75.0f)
        printf("Grade: B\n");
    else if (average >= 70.0f)
        printf("Grade: B-\n");
    else if (average >= 65.0f)
        printf("Grade: C+\n");
    else if (average >= 65.0f)
        printf("Grade: C\n");
    else if (average >= 60.0f)
        printf("Grade: C-\n");
    else if (average >= 55.0f)
        printf("Grade: D+\n");
    else if (average >= 50.0f)
        printf("Grade: D\n");
     else if (average >= 45.0f)
        printf("Grade: D-\n");
    else if (average >= 40.0f)
        printf("Grade: E\n");
    else
        printf("Grade: F\n");



    return 0;
}
