#include <cs50.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

// Function prototypes
bool is_valid_key(string key);
char rotate(char c, int shift);

int main(int argc, string argv[])
{
    
    if (argc != 2)
    {
        printf("Usage: ./vigenere keyword\n");
        return 1;
    }
    
    // Validate that keyword contains only alphabetic characters
    if (!is_valid_key(argv[1]))
    {
        printf("Usage: ./vigenere keyword\n");
        return 1;
    }
    
    string keyword = argv[1];
    int keyword_length = strlen(keyword);
    
    // Get plaintext from user
    string plaintext = get_string("plaintext:  ");
    
    // Print ciphertext header
    printf("ciphertext: ");
    
    // Track position in keyword (only increment for alphabetic chars)
    int key_index = 0;
    
    // Encrypt each character
    for (int i = 0, n = strlen(plaintext); i < n; i++)
    {
        char current_char = plaintext[i];
        
        // Only encrypt alphabetic characters
        if (isalpha(current_char))
        {
            // Get current keyword character and convert to shift value
            // 'A' or 'a' = 0, 'B' or 'b' = 1, etc.
            char key_char = tolower(keyword[key_index % keyword_length]);
            int shift = key_char - 'a';
            
            // Encrypt character with current shift
            char encrypted = rotate(current_char, shift);
            printf("%c", encrypted);
            
            // Move to next position in keyword
            key_index++;
        }
        else
        {
            // Non-alphabetic characters remain unchanged
            printf("%c", current_char);
        }
    }
    
    printf("\n");
    return 0;
}

// Check if string contains only alphabetic characters
bool is_valid_key(string key)
{
    for (int i = 0, n = strlen(key); i < n; i++)
    {
        if (!isalpha(key[i]))
        {
            return false;
        }
    }
    return true;
}

// Rotate character by shift positions
{
    if (isupper(c))
    {
        // Rotate uppercase letter
        return (c - 'A' + shift) % 26 + 'A';
    }
    else
    {
        // Rotate lowercase letter
        return (c - 'a' + shift) % 26 + 'a';
    }
}
